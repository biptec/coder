FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

ARG TARGETARCH
ARG CODER_VERSION

LABEL \
	org.opencontainers.image.title="Coder Workspace Volume Copy" \
	org.opencontainers.image.description="Minimal rsync helper for administrative Coder workspace persistent-volume copies." \
	org.opencontainers.image.source="https://github.com/coder/coder" \
	org.opencontainers.image.version="$CODER_VERSION"

RUN apk add --no-cache acl rsync \
	&& rsync --version \
	&& getfacl --version \
	&& setfacl --version

COPY --chmod=755 build/coder-volume-copy-helper-linux-${TARGETARCH} /opt/coder-volume-copy-helper

ENTRYPOINT ["/opt/coder-volume-copy-helper"]
